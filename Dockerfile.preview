FROM node:24-alpine
ENV NODE_ENV=development \
    TGL_ENV=preview \
    WORKSHOP_PREVIEW_BIND=0.0.0.0 \
    WORKSHOP_ALLOW_CLOUD_PREVIEW=1 \
    TGL_WORKSHOP_DIR=/data \
    PORT=4174
WORKDIR /app
RUN apk add --no-cache su-exec openssl
COPY --chown=node:node . /app
# Fail closed on missing visual baselines and regressions to oversized critical assets.
RUN node scripts/check-static-site.mjs && node --test tests/performance-budget.test.mjs && node scripts/check-release-contract.mjs
RUN mkdir -p /data && chown node:node /data
EXPOSE 4174
# Railway volumes are initially root-owned and hide image-time /data ownership.
# Set mount permissions on startup, then permanently drop root privileges.
CMD ["sh", "-c", "chown node:node /data && exec su-exec node node scripts/workshop-preview.mjs"]
