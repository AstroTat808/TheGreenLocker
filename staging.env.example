# Copy to staging.env (gitignored), then generate new independent secrets.
STAGING_DOMAIN=staging.thegreenlocker.com
TGL_PUBLIC_ORIGIN=https://staging.thegreenlocker.com
STAGING_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_BCRYPT_HASH
TGL_MAIL_MODE=resend
TGL_EMAIL_FROM=The Green Locker <verified-sender@example.com>
TGL_RESEND_API_KEY=REPLACE_WITH_SCOPED_RESEND_KEY
TGL_MFA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
TGL_INVITE_CODE=REPLACE_WITH_RANDOM_INVITATION_SECRET
